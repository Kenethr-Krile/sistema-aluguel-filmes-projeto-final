package listas;

import java.io.BufferedWriter;
import java.io.FileWriter;
import java.io.IOException;
import java.io.BufferedReader;
import java.io.FileReader;

public class ArquivoFuncao {

    // Adicionar informações ao arquivo
    public static void adicionar(String arquivo, String dados) {

        try (BufferedWriter bw = new BufferedWriter(
                new FileWriter(arquivo, true))) {

            bw.write(dados);
            bw.newLine();

            System.out.println("Dados salvos com sucesso!");

        } catch (IOException e) {
            System.out.println("Erro ao salvar: " + e.getMessage());
        }
    }

    // Ler informações do arquivo
    public static void listar(String arquivo) {

        try (BufferedReader br = new BufferedReader(
                new FileReader(arquivo))) {

            String linha;

            while ((linha = br.readLine()) != null) {
                System.out.println(linha);
            }

        } catch (IOException e) {
            System.out.println("Erro ao ler arquivo: " + e.getMessage());
        }
    }
}

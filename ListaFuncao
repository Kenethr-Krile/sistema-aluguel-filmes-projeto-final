    public static void listarLocacaoPorCliente(String cpfBusca) {

        System.out.println("\n LOCACOES DO CLIENTE (CPF: " + cpfBusca + ")");

        String arquivo = "locacoes.txt";

        try (BufferedReader br = new BufferedReader(
                new FileReader(arquivo))) {

            String linha;
            int contador = 0;

            while ((linha = br.readLine()) != null) {

                String[] dados = linha.split(";");

                // Verifica se o registro possui os 4 campos
                if (dados.length != 4) {
                    System.out.println("Registro invalido: " + linha);
                    continue;
                }

                // Filtra apenas as locacoes do CPF informado
                if (dados[0].equalsIgnoreCase(cpfBusca)) {
                    contador++;

                    System.out.println("\n----------------------------------------");
                    System.out.printf("LOCACAO #%d\n", contador);
                    System.out.println("----------------------------------------");

                    System.out.printf("CPF Cliente:  %s\n", dados[0]);
                    System.out.printf("Filme:        %s\n", dados[1]);
                    System.out.printf("Data:         %s\n", dados[2]);
                    System.out.printf("Valor Total:  R$ %s\n", dados[3]);
                }
            }

            System.out.println("\n----------------------------------------");
            System.out.println("Total de locacoes deste cliente: " + contador);
            System.out.println("========================================");

        } catch (IOException e) {
            System.out.println("Erro ao ler arquivo: " + e.getMessage());
        }
    }


            System.out.printf("ATRIBUTO CLIENTE 1:       %s\n", dados[0]);
            System.out.printf("ATRIBUTO CLIENTE 2:          %s\n", dados[1]);
            System.out.printf("ATRIBUTO CLIENTE 3:%s anos\n", dados[2]);
            System.out.printf("ATRIBUTO CLIENTE 4:      %s minutos\n", dados[3]);
            System.out.printf("ATRIBUTO CLIENTE 5:       %s\n", dados[4]);
        }

        System.out.println("\n----------------------------------------");
        System.out.println("Total de clientes: " + contador);
